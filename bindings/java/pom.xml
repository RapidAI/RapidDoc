<?xml version="1.0" encoding="utf-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>io.github.rapidai</groupId>
  <artifactId>rapid-doc</artifactId>
  <version>0.1.0</version>
  <name>RapidDoc Java SDK</name>
  <description>Native Rust document parsing with Java 8 bytecode compatibility</description>
  <url>https://github.com/RapidAI/RapidDoc</url>
  <scm>
    <url>https://github.com/RapidAI/RapidDoc</url>
    <connection>scm:git:https://github.com/RapidAI/RapidDoc.git</connection>
    <developerConnection>scm:git:ssh://git@github.com/RapidAI/RapidDoc.git</developerConnection>
  </scm>
  <developers>
    <developer>
      <id>rapidai</id>
      <name>RapidAI contributors</name>
      <url>https://github.com/RapidAI</url>
    </developer>
  </developers>
  <licenses>
    <license>
      <name>Apache License 2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0</url>
    </license>
  </licenses>
  <properties>
    <maven.compiler.release>8</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <rapid-doc.ort.version>1.23.2</rapid-doc.ort.version>
  </properties>
  <dependencies>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <version>2.21.4</version>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>5.14.3</version>
      <scope>test</scope>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.14.1</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.5</version>
        <configuration>
          <argLine>-Xcheck:jni</argLine>
          <systemPropertyVariables>
            <rapiddoc.test.root>${project.basedir}/../..</rapiddoc.test.root>
          </systemPropertyVariables>
        </configuration>
      </plugin>
    </plugins>
  </build>
  <profiles>
    <profile>
      <id>release</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-source-plugin</artifactId>
            <version>3.3.1</version>
            <executions>
              <execution>
                <id>sources</id>
                <goals>
                  <goal>jar-no-fork</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-javadoc-plugin</artifactId>
            <version>3.12.0</version>
            <configuration>
              <doclint>none</doclint>
            </configuration>
            <executions>
              <execution>
                <id>javadoc</id>
                <goals>
                  <goal>jar</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
    <profile>
      <id>windows-x86_64</id>
      <activation>
        <os>
          <family>Windows</family>
          <arch>amd64</arch>
        </os>
      </activation>
      <properties>
        <rapid-doc.native.classifier>windows-x86_64</rapid-doc.native.classifier>
      </properties>
      <dependencies>
        <dependency>
          <groupId>io.github.rapidai</groupId>
          <artifactId>rapid-doc-native</artifactId>
          <version>${project.version}</version>
          <classifier>${rapid-doc.native.classifier}</classifier>
          <scope>runtime</scope>
        </dependency>
        <dependency>
          <groupId>io.github.rapidai</groupId>
          <artifactId>rapid-doc-ort</artifactId>
          <version>${rapid-doc.ort.version}</version>
          <classifier>${rapid-doc.native.classifier}</classifier>
          <scope>runtime</scope>
        </dependency>
      </dependencies>
    </profile>
    <profile>
      <id>linux-x86_64</id>
      <activation>
        <os>
          <name>Linux</name>
          <arch>amd64</arch>
        </os>
      </activation>
      <properties>
        <rapid-doc.native.classifier>linux-x86_64</rapid-doc.native.classifier>
      </properties>
      <dependencies>
        <dependency>
          <groupId>io.github.rapidai</groupId>
          <artifactId>rapid-doc-native</artifactId>
          <version>${project.version}</version>
          <classifier>${rapid-doc.native.classifier}</classifier>
          <scope>runtime</scope>
        </dependency>
        <dependency>
          <groupId>io.github.rapidai</groupId>
          <artifactId>rapid-doc-ort</artifactId>
          <version>${rapid-doc.ort.version}</version>
          <classifier>${rapid-doc.native.classifier}</classifier>
          <scope>runtime</scope>
        </dependency>
      </dependencies>
    </profile>
  </profiles>
</project>
